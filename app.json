{
  "expo": {
    "name": "Dawinix HT",
    "slug": "dawinix-ht",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "dawinixht",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.onspace.dawinix2026.v2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Dawinix uses your microphone for voice input and voice messages.",
        "NSCameraUsageDescription": "Dawinix uses your camera to capture and upload images.",
        "NSPhotoLibraryUsageDescription": "Dawinix accesses your photo library to upload images.",
        "NSPhotoLibraryAddUsageDescription": "Dawinix saves generated images to your photo library.",
        "NSSpeechRecognitionUsageDescription": "Dawinix uses speech recognition for voice-to-text input.",
        "NSFaceIDUsageDescription": "Dawinix uses Face ID for secure authentication.",
        "NSContactsUsageDescription": "Dawinix may access contacts to help you share conversations."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.onspace.dawinix2026.v2",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4e273b4c-f781-4751-85ba-caf9379e8953"
      },
      "revenueCatIosKey": "appl_LCOBkSEKCqNFllINWlYWexOVaHf",
      "revenueCatAndroidKey": "goog_htwkRFMSklkJWsTytqppHVTxkkP"
    }
  }
}
