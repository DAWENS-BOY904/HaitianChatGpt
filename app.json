{
  "expo": {
    "name": "Dawinix HT",
    "slug": "dawinix-ht",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "dawinixht",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "owner": "dawens-boy",

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.onspace.dawinix-ht",
      "buildNumber": "1.0.0",
      "usesAppleSignIn": true,

      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses microphone for AI voice chat.",
        "NSCameraUsageDescription": "This app uses camera for AI features.",
        "NSPhotoLibraryUsageDescription": "This app accesses photos for uploads."
      }
    },

    "android": {
      "package": "com.onspace.dawinix-ht",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,

      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],

      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },

      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "dawinixht"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },

    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-av",
      "expo-speech",
      "expo-notifications",
      "expo-in-app-purchases",

      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],

      "expo-web-browser"
    ],

    "extra": {
      "OPENAI_API_KEY": "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",
      "SUPABASE_URL": "https://njpuoozygqtpvlzhnjpu.backend.onspace.ai",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJleHAiOjIwODEyMTE5MjgsImlhdCI6MTc2NTg1MTkyOCwiaXNzIjoib25zcGFjZSIsInJlZiI6Im5qcHVvb3p5Z3F0cHZsemhuanB1Iiwicm9sZSI6ImFub24ifQ.m9dWtFpSOKlzaAwX1AyGE1b-HkzGs2PnIZYrfJ35HT8"
    },

    "updates": {
      "fallbackToCacheTimeout": 0
    },

    "runtimeVersion": {
      "policy": "appVersion"
    },

    "experiments": {
      "typedRoutes": true
    }
  }
}
