{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EXPO_PUBLIC_RC_IOS_KEY": "appl_LCOBkSEKCqNFllINWlYWexOVaHf",
        "EXPO_PUBLIC_RC_ANDROID_KEY": "goog_htwkRFMSklkJWsTytqppHVTxkkP"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "credentialsSource": "remote",
        "resourceClass": "m-medium",
        "enterpriseProvisioning": "universal"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "production-android": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "local": {
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "credentialsSource": "local",
        "simulator": false
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "EAS_NO_FROZEN_LOCKFILE": "1",
        "npm_config_legacy_peer_deps": "true"
      }
    },
    "local-apk": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_NO_CAPABILITY_SYNC": "1",
        "npm_config_legacy_peer_deps": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6763410636",
        "appleTeamId": "3CTX33Z5P3"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "production"
      }
    }
  }
}
